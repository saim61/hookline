# Copy to .env for local development. Defaults below match compose.yaml,
# so an unmodified copy works out of the box.
#
# Every setting is read with the HOOKLINE_ prefix. See src/hookline/config.py.

# Service name, used in logs.
HOOKLINE_APP_NAME=hookline

# Echo SQL to stdout. Useful while learning, noisy otherwise.
HOOKLINE_DEBUG=false

# Postgres DSN. The +asyncpg driver is required - a plain postgresql:// URL
# will fail at startup because the engine is async.
# If port 5432 is taken by a local Postgres, change compose.yaml to "5433:5432"
# and set the port here to match.
HOOKLINE_DATABASE_URL=postgresql+asyncpg://hookline:hookline@localhost:5432/hookline

# Delivery attempts before a delivery is moved to the dead letter queue. Snapshotted
# onto each delivery at fan-out, so lowering it will not dead-letter queued work.
HOOKLINE_MAX_DELIVERY_ATTEMPTS=5

# Per-request timeout when POSTing to a customer endpoint, in seconds.
HOOKLINE_DELIVERY_TIMEOUT_SECONDS=10.0

# --- worker loop -----------------------------------------------------------
HOOKLINE_WORKER_POLL_INTERVAL_SECONDS=1.0
HOOKLINE_WORKER_BATCH_SIZE=20

# When a delivery stuck in_flight is assumed to belong to a crashed worker and is
# returned to pending. Must comfortably exceed DELIVERY_TIMEOUT_SECONDS, or rows a
# healthy worker is still sending get reclaimed and delivered twice.
HOOKLINE_STALE_DELIVERY_TIMEOUT_SECONDS=300.0

# --- retry backoff ---------------------------------------------------------
# Delay after failure N is a random value in [exp/2, exp] where exp = base * 2^(N-1),
# capped at the max. The jitter is what stops a recovered endpoint being hit by every
# queued delivery at the same instant.
HOOKLINE_RETRY_BASE_DELAY_SECONDS=10.0
HOOKLINE_RETRY_MAX_DELAY_SECONDS=3600.0

# --- circuit breaker -------------------------------------------------------
HOOKLINE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
HOOKLINE_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60.0

# --- redis -----------------------------------------------------------------
# Holds only derived state: rate limit buckets, circuit breaker counters, the
# subscriber cache. Every caller fails open, so losing Redis degrades limiting and
# caching but never loses a delivery, and /ready stays 200.
HOOKLINE_REDIS_URL=redis://localhost:6379/0

# "redis" shares breaker state across all workers; "memory" keeps it per process.
HOOKLINE_CIRCUIT_BREAKER_BACKEND=redis

# --- rate limiting ---------------------------------------------------------
# Inbound, per caller, on write routes only. Capacity is the burst, refill is the
# sustained rate.
HOOKLINE_RATE_LIMIT_ENABLED=true
HOOKLINE_RATE_LIMIT_CAPACITY=100
HOOKLINE_RATE_LIMIT_REFILL_PER_SECOND=20.0

# Outbound, per destination endpoint, shared across workers. Protects the customer's
# server rather than ours.
HOOKLINE_DELIVERY_RATE_LIMIT_ENABLED=true
HOOKLINE_DELIVERY_RATE_LIMIT_CAPACITY=20
HOOKLINE_DELIVERY_RATE_LIMIT_PER_SECOND=10.0

# --- caching ---------------------------------------------------------------
# Backstop only. Invalidation is explicit on every endpoint change, so this bounds
# how long a stale entry could survive a crash between the write and the delete.
HOOKLINE_SUBSCRIBER_CACHE_TTL_SECONDS=30

# --- auth ------------------------------------------------------------------
# Every /api/v1 route requires `Authorization: Bearer hl_...`. Create the first key
# with: uv run hookline-admin create-key --name "local dev"
# Setting this to false treats every request as holding the admin scope. Local only.
HOOKLINE_AUTH_ENABLED=true

# Clock-skew window for keys created with --signed-requests. Wide enough for ordinary
# skew, narrow enough that a captured request stops working.
HOOKLINE_INBOUND_SIGNATURE_TOLERANCE_SECONDS=300

# --- observability ---------------------------------------------------------
# /metrics on the API, plus a small listener in the worker (it serves no HTTP
# otherwise). Both unauthenticated, like the health probes.
HOOKLINE_METRICS_ENABLED=true
HOOKLINE_WORKER_METRICS_PORT=9100

# OTLP/HTTP collector, e.g. http://localhost:4318/v1/traces. Tracing stays off while
# unset: an SDK exporting nowhere costs per-span work and only looks instrumented.
# HOOKLINE_OTEL_ENDPOINT=

# --- dashboard -------------------------------------------------------------
# Server-rendered operator UI at /dashboard. Sign in with any API key; the key is
# exchanged for a Redis-backed session, so it never sits in the browser.
HOOKLINE_DASHBOARD_ENABLED=true
