# Copy to .env for local development. Defaults below match compose.yaml,
# so an unmodified copy works out of the box.
#
# Every setting is read with the HOOKLINE_ prefix. See src/hookline/config.py.

# Service name, used in logs.
HOOKLINE_APP_NAME=hookline

# Echo SQL to stdout. Useful while learning, noisy otherwise.
HOOKLINE_DEBUG=false

# Postgres DSN. The +asyncpg driver is required - a plain postgresql:// URL
# will fail at startup because the engine is async.
# If port 5432 is taken by a local Postgres, change compose.yaml to "5433:5432"
# and set the port here to match.
HOOKLINE_DATABASE_URL=postgresql+asyncpg://hookline:hookline@localhost:5432/hookline

# Delivery attempts before an event is moved to the dead letter queue.
HOOKLINE_MAX_DELIVERY_ATTEMPTS=5

# Per-request timeout when POSTing to a customer endpoint, in seconds.
HOOKLINE_DELIVERY_TIMEOUT_SECONDS=10.0
