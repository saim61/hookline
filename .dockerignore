# Everything the image does not need. This is not only about size: each ignored path is one
# less thing that can invalidate the build cache, and .env is one less way to bake a
# credential into a layer that will be pushed to a registry.

.git
.gitignore
.github

.venv
__pycache__
*.pyc
*.pyo

.env
.env.*
!.env.example

tests
.pytest_cache
.coverage
.coverage.*
htmlcov
coverage.xml
.mypy_cache
.ruff_cache

deploy
compose.yaml
Dockerfile
.dockerignore
HOOKLINE_CONTEXT.md

# README.md is NOT ignored: pyproject.toml declares `readme = "README.md"`, so the build
# backend reads it to build the package metadata and fails without it.
